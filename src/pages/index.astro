---
import Base from '../layouts/Base.astro';
import { news, sites, institutions, pathFor } from '../data/index.js';
const recent = news.filter(n=>n.published).slice(0,3);
---
<Base title="Home">
<section class="hero">
<div class="container">
<div class="hero-branding"><img src={pathFor('images/icona-logo.png')} alt="ICONA — International Consortium for Natural Analogues" /></div>
<div class="eyebrow">International Consortium for Natural Analogues</div>
<h1>Exploring the oceans of tomorrow, today.</h1>
<p>A global consortium of researchers using natural analogue systems to understand the ecological consequences of environmental change.</p>
<div class="hero-actions"><a class="btn" href={pathFor('network/')}>Explore the global network ↗</a>
<a class="btn btn-outline" href={pathFor('about/')}>About ICONA</a>
</div>
</div>
</section>
<section class="section">
<div class="container split">
<div>
<div class="eyebrow">About our network</div>
<h2>Connecting natural analogue systems around the world.</h2>
<p class="lead">ICONA brings together researchers studying marine ecosystems exposed to naturally altered environmental conditions, helping us understand long-term responses to ocean acidification and other global changes.</p>
<a href={pathFor('about/')} class="btn btn-outline">Our mission →</a>
</div>
<div class="feature">
<div><span>CO₂</span><h3>Real ecosystems. Long-term exposure.<br/>Global collaboration.</h3>
</div>
</div>
</div>
</section>
<section class="section alt">
<div class="container">
<div class="section-head">
<div>
<div class="eyebrow">Around the world</div>
<h2>A connected research community</h2>
<p>Explore the locations and institutions contributing to natural analogue research.</p>
</div>
<a href={pathFor('network/')}>View network map →</a>
</div>
<div class="cards">
<article class="card">
<span class="pill">Research</span><h3>Natural analogue sites</h3>
<p>Discover the environments and systems where long-term ecological change can be studied.</p>
<a href={pathFor('network/')}>Explore {sites.filter(s=>s.published).length} sites →</a>
</article>
<article class="card"><span class="pill">Collaboration</span><h3>Global institutions</h3>
<p>Find contributing institutions and connect with the researchers working across sites.</p>
<a href={pathFor('network/')}>Explore institutions →</a>
</article>
<article class="card"><span class="pill">Publications</span><h3>Shared scientific knowledge</h3>
<p>Browse the publications associated with the network.</p>
<a href={pathFor('publications/')}>View publications →</a>
</article>
</div>
</div>
</section>
<section class="section">
<div class="container">
<div class="section-head">
<div>
<div class="eyebrow">Network updates</div>
<h2>Latest news</h2>
</div>
<a href={pathFor('news/')}>All news →</a>
</div>
<div class="cards">{recent.map(item=><article class="card"><span class="meta">{item.date}</span><h3>{item.title}</h3>
<p>{item.summary}</p>
<a href={pathFor('news/'+item.slug+'/')}>Read more →</a>
</article>
)}
</div>
</div>
</section>
</Base>
