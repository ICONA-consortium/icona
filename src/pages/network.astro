---
import Base from '../layouts/Base.astro';
import { sites, institutions, pathFor } from '../data/index.js';
const publishedSites = sites.filter(s=>s.published);
const publishedInstitutions = institutions.filter(i=>i.published);
const mapData = [...publishedSites.map(s=>({...s,type:'site',url:pathFor('sites/'+s.slug+'/')})),...publishedInstitutions.map(i=>({...i,type:'institution',url:i.website||''}))];
---
<Base title="Global network"><section class="page-head"><div class="container"><div class="eyebrow">Our global network</div><h1>Sites & collaborators</h1><p>Explore natural laboratories and the institutions connected to them. Filter by location type or search by name and country.</p></div></section><section class="section"><div class="container"><div class="map-wrap"><div class="map-toolbar"><div class="filter-buttons" role="group" aria-label="Map filters"><button data-filter="all" class="active" aria-pressed="true">All locations</button><button data-filter="site" aria-pressed="false">Research sites</button><button data-filter="institution" aria-pressed="false">Institutions</button></div><input type="search" id="location-search" placeholder="Search by name or country…" aria-label="Search locations"/></div><div id="network-map" aria-label="Interactive map of ICONA locations"></div><div class="map-key"><span><i class="dot site"></i> Natural laboratory</span><span><i class="dot institution"></i> Collaborating institution</span><span id="map-count" aria-live="polite"></span></div></div><h2 style="margin-top:55px">Natural laboratory sites</h2><div class="info-grid">{publishedSites.map(site=><article class="card"><div class="tag">{site.country}</div><h3>{site.name}</h3><p>{site.description}</p><a href={pathFor('sites/'+site.slug+'/')}>View site profile →</a></article>)}</div><h2 style="margin-top:55px">Collaborating institutions</h2><div class="info-grid">{publishedInstitutions.map(inst=><article class="card"><div class="tag">{inst.country}</div><h3>{inst.name}</h3><p>{inst.description}</p>{inst.website && <a href={inst.website} target="_blank" rel="noopener noreferrer">Institution website ↗</a>}</article>)}</div></div></section><script id="map-data" type="application/json" set:html={JSON.stringify(mapData)}></script>
<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  const mapData=JSON.parse(document.getElementById('map-data').textContent);
  { const map=L.map('network-map',{scrollWheelZoom:false}).setView([18,12],2);L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',maxZoom:18}).addTo(map);
  const markerLayer=L.layerGroup().addTo(map); let filter='all'; const input=document.querySelector('#location-search'); const count=document.querySelector('#map-count');
  function update(){markerLayer.clearLayers();const term=input.value.toLowerCase().trim();const visible=mapData.filter(item=>(filter==='all'||item.type===filter)&&[item.name,item.country,item.city||''].join(' ').toLowerCase().includes(term));visible.forEach(item=>{ const icon=L.divIcon({className:'',html:`<div style="width:16px;height:16px;border:3px solid white;border-radius:${item.type==='site'?'50%':'3px'};background:${item.type==='site'?'#007f88':'#e89e37'};box-shadow:0 1px 7px #1238"></div>`,iconSize:[18,18]});const marker=L.marker([item.latitude,item.longitude],{icon}).addTo(markerLayer);const wrap=document.createElement('div');const h=document.createElement('strong');h.textContent=item.name;const p=document.createElement('p');p.textContent=item.country;wrap.append(h,p);if(item.url){const a=document.createElement('a');a.href=item.url;a.textContent=item.type==='site'?'Site profile →':'Institution website ↗';wrap.append(a)}marker.bindPopup(wrap)});count.textContent=`Showing ${visible.length} locations`;}
  document.querySelectorAll('[data-filter]').forEach(button=>button.addEventListener('click',()=>{filter=button.dataset.filter;document.querySelectorAll('[data-filter]').forEach(b=>{b.classList.toggle('active',b===button);b.setAttribute('aria-pressed',String(b===button))});update()}));input.addEventListener('input',update);update();setTimeout(()=>map.invalidateSize(),80);
  }
</script></Base>
