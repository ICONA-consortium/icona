---
import Base from '../layouts/Base.astro';
---
<Base title="Publications">
  <section class="page-head">
    <div class="container">
      <div class="eyebrow">Research outputs</div>
      <h1>Publications</h1>
      <p>A shared bibliography of ICONA-associated research.</p>
    </div>
  </section>
  <section class="section">
    <div class="container text-width">
      <div id="bibbase-container">
        <script
          is:inline
          src="https://bibbase.org/show?bib=https%3A%2F%2Fbibbase.org%2Fzotero-group%2Fbpharvey%2F4668041&amp;jsonp=1&amp;group0=year&amp;sort=year&amp;showSearch=1&amp;owner=none"
        ></script>
      </div>
    </div>
  </section>
</Base>
