---
import Base from '../../layouts/Base.astro';
import { sites, institutions, pathFor } from '../../data/index.js';
export function getStaticPaths(){return sites.filter(s=>s.published).map(site=>({params:{slug:site.slug},props:{site}}));}
const {site}=Astro.props;
const linked=institutions.filter(i=>i.published && (site.institution_ids||[]).includes(i.slug));
---
<Base title={site.name}><section class="page-head"><div class="container"><div class="eyebrow">Research site · {site.country}</div><h1>{site.name}</h1><p>{site.description}</p></div></section><section class="section"><div class="container text-width"><a class="back" href={pathFor('network/')}>← Back to global network</a><h2>Site overview</h2><p>{site.description}</p><p><strong>Category:</strong> {site.category || site.environment || "Not classified"}</p>{site.environment && <p><strong>Environmental description:</strong> {site.environment}</p><p><strong>Coordinates:</strong> {site.latitude}, {site.longitude}</p>{site.image && <img src={site.image} alt={`${site.name} research site`} style="max-width:100%;border-radius:8px"/>}<h2 style="margin-top:40px">Associated institutions</h2>{linked.length ? linked.map(i=><p><a href={i.website}>{i.name}</a></p>) : <p>Institutional relationships can be added through the CMS.</p>}{site.website && <p><a href={site.website}>Learn more about this site ↗</a></p>}</div></section></Base>
